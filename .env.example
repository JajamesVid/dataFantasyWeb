# Copia este fichero a .env y rellena tus credenciales reales.
# .env está en .gitignore: nunca se sube al repositorio.

# Developer App de X/Twitter (developer.twitter.com) con permisos de lectura+escritura.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Dominio base usado para construir el link del artículo en el tuit.
SITE_BASE_URL=http://localhost:5000

# Proyecto de Supabase (Settings > API en el dashboard).
SUPABASE_URL=
SUPABASE_KEY=
# Temporada que se muestra en la web (formato "25/26").
SUPABASE_TEMPORADA=25/26

# Panel de administración (/panel). Genera el hash con: python scripts/generate_admin_hash.py
FLASK_SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
