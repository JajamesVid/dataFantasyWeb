# Copia este fichero a .env y rellena tus credenciales reales.
# .env está en .gitignore: nunca se sube al repositorio.

# Developer App de X/Twitter (developer.twitter.com) con permisos de lectura+escritura.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Dominio base usado para construir el link del artículo en el tuit.
SITE_BASE_URL=http://localhost:5000

# Proyecto de Supabase (Settings > API en el dashboard).
SUPABASE_URL=
# Clave PUBLICABLE (sb_publishable_...), nunca la secreta (sb_secret_...): la web solo
# lee, y la secreta se salta RLS y permite borrar cualquier tabla. Necesita las políticas
# de DataFantasy/BBDD/03_politicas_lectura_web.sql.
SUPABASE_KEY=
# Temporada que se muestra en la web (formato "25/26").
SUPABASE_TEMPORADA=25/26
# Temporadas que aún se leen de las tablas _stg (staging) en vez de producción,
# separadas por comas (ej. "26/27" o "26/27,27/28"). Vacío = todo desde producción.
SUPABASE_STAGING_TEMPORADAS=

# Panel de administración (/panel). Genera el hash con: python scripts/generate_admin_hash.py
FLASK_SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Solo en el servidor (los pone deploy/datafantasy-web.service, no hace falta aquí):
# CONTENT_DIR=/srv/datafantasy/content  -> artículos, imágenes y visitas fuera del repo
# BEHIND_PROXY=1                        -> fiarse de X-Forwarded-For que pone Caddy
