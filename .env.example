# Copia este fichero a .env y rellena tus credenciales reales.
# .env está en .gitignore: nunca se sube al repositorio.

# Developer App de X/Twitter (developer.twitter.com) con permisos de lectura+escritura.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Dominio base usado para construir el link del artículo en el tuit.
SITE_BASE_URL=http://localhost:5000
